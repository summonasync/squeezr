{
  "theme": "dark",
  "model": "qwen3-coder",
  "editor": {
    "tabSize": 4
  },
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "squeezr": {
      "command": "/opt/squeezr/bin/squeezr",
      "args": [
        "serve",
        "--watch"
      ],
      "cwd": "/work/demo",
      "versionNegotiation": "auto"
    }
  }
}