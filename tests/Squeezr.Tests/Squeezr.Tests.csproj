<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1416;CS0649;CS8600;CS8602;CS8603;CS8604;xUnit1031</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Spectre.Console.Testing" Version="0.55.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Squeezr.Cli\Squeezr.Cli.csproj" />
    <ProjectReference Include="..\..\src\Squeezr.Core\Squeezr.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**/Fixtures/**/*.cs" />
    <None Include="**/Fixtures/**/*" Exclude="$(BaseOutputPath)/**;$(IntermediateOutputPath)/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>